{
  "name": "valery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:architecture": "depcruise --validate .dependency-cruiser.cjs src && node scripts/verify-architecture.mjs && node scripts/verify-environment-access.mjs",
    "test:security-headers": "node scripts/smoke-security-headers.mjs",
    "audit:dependencies": "corepack pnpm audit --audit-level=high",
    "scan:secrets": "node scripts/verify-secrets.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/shared/infrastructure/db/migrate.ts",
    "db:seed": "tsx src/shared/infrastructure/db/seed.ts",
    "db:seed:admin": "tsx src/modules/auth/infrastructure/seed-admin.ts",
    "db:setup": "tsx src/shared/infrastructure/db/setup.ts",
    "test:e2e": "playwright test",
    "verify": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm test:architecture && corepack pnpm build && corepack pnpm test:security-headers"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@node-rs/argon2": "2.2.2",
    "@tailwindcss/postcss": "4.3.3",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.4",
    "dependency-cruiser": "18.6.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "otpauth": "9.5.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
