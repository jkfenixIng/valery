# PostgreSQL native development example. Replace only in your untracked .env.local.
# This is a development-only placeholder, not a real credential.
DATABASE_URL=postgresql://valery_dev:valery_dev@localhost:5432/valery_dev

# Authentication development placeholders. Never commit real values.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters

